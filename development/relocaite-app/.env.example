# Server-side only. Use a dedicated, restricted project key.
# Never expose this value through a NEXT_PUBLIC_ variable or commit .env.local.
OPENAI_API_KEY=

# Optional override for contract extraction.
OPENAI_CONTRACT_MODEL=gpt-5-mini

# Server-only credential for official-source monitoring.
# Never expose this value through a NEXT_PUBLIC_ variable.
FIRECRAWL_API_KEY=fc-your-key
